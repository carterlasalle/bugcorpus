{
  "description": "Bug Corpus cheap hooks. Advisory only: findings surface in context, CI enforces. Project hooks require trust; see https://learn.chatgpt.com/docs/hooks",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run bugcorpus hooks post-tool-use",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run bugcorpus hooks session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run bugcorpus hooks session-stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
