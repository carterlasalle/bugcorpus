{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "trace hook session-start --format claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run bugcorpus hooks session-start",
            "timeout": 30
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "trace hook prompt-context --format claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "trace hook pre-mutation --format claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "trace hook post-mutation --format claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "trace hook post-mutation --format claude"
          }
        ]
      },
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "trace hook post-mutation --format claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run bugcorpus hooks post-tool-use",
            "timeout": 60
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "trace hook post-batch --format claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "trace hook stop --format claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run bugcorpus hooks session-stop",
            "timeout": 30
          }
        ],
        "matcher": ""
      }
    ]
  }
}
